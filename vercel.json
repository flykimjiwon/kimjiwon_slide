{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/agentmake",
      "destination": "/agentmake/index.html"
    },
    {
      "source": "/sbti2",
      "destination": "/sbti2/index.html"
    },
    {
      "source": "/sbti3",
      "destination": "/sbti3/index.html"
    },
    {
      "source": "/sbti1",
      "destination": "/sbti1/index.html"
    },
    {
      "source": "/sbtifull",
      "destination": "/sbtifull/index.html"
    },
    {
      "source": "/sbtifull/compare",
      "destination": "/sbtifull/compare.html"
    },
    {
      "source": "/original",
      "destination": "/original.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
